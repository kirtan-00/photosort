#!/bin/bash
# PhotoSort.app: start the local server (no folder yet) and open the browser.
# The app itself asks for a folder via the Open folder button / picker.
REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
LOG="$HOME/Library/Logs/photosort.log"
cd "$REPO"
export HF_HUB_OFFLINE=1
# A server from a previous launch may still own the port; replace it.
pkill -f "photosort.cli serve" 2>/dev/null; sleep 0.5
echo "[$(date)] launching from $REPO" >> "$LOG"
exec "$REPO/.venv/bin/python" -m photosort.cli serve --open >> "$LOG" 2>&1
